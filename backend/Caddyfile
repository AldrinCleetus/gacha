{
    email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
    # Proxy /api and /health to Fastify API service
    handle /api/* {
        reverse_proxy api:3001
    }

    handle /health {
        reverse_proxy api:3001
    }

    # Fallback response until frontend is integrated
    handle {
        respond "gacha backend production gateway operational" 200
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    encode gzip zstd
    log {
        output stdout
        format console
    }
}
