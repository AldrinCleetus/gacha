# ==============================================================================
# gacha Backend Environment Variables (.env)
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
TZ=UTC

# PostgreSQL Database (used by API, worker, migrations)
# In Docker compose: postgresql://postgres:postgres@postgres:5432/gacha
# On host machine: postgresql://postgres:postgres@localhost:5433/gacha
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gacha

# PostgreSQL container credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gacha
POSTGRES_PORT=5433

# Raw payload storage (HTML/PDF archival storage)
RAW_STORAGE_DRIVER=local
RAW_STORAGE_PATH=/app/data/raw

# Publishing configuration (F5 single-source dev flag)
SINGLE_SOURCE_PUBLISH=true

# Admin token (for protected /admin/* routes in F10)
ADMIN_TOKEN=dev_admin_token_change_in_production

# Clerk Authentication (Google OAuth)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
